{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      ".indexOn": ["createdAt"],
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && data.child('ownerId').val() === auth.uid",
        "ownerId": {
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
        },
        "createdAt": {
          ".write": "auth != null"
        },
        "lastActivityAt": {
          ".write": "auth != null"
        },
        "ownerState": {
          ".write": "auth != null && root.child('rooms/' + $roomId + '/ownerId').val() === auth.uid"
        },
        "active_users": {
          "$userId": {
            ".write": "auth != null && auth.uid === $userId"
          }
        },
        "messages": {
          "$messageId": {
            ".write": "auth != null"
          }
        },
        "events": {
          "$eventId": {
            ".write": "auth != null && root.child('rooms/' + $roomId + '/ownerId').val() === auth.uid"
          }
        }
      }
    }
  }
}
